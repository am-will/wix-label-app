{
  "name": "wix-label-generator",
  "version": "1.0.0",
  "description": "Wix Order Label Generator - Pull orders, generate labels, print or save as PDF",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "build": "electron-builder --linux",
    "build:linux": "electron-builder --linux",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.wixlabels.generator",
    "productName": "Wix Label Generator",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  }
}
